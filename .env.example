# Neon Postgres（pooled connection string）
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Vercel Blob。Vercel連携時は自動設定されます
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxx

# 32文字以上のランダムな値: openssl rand -base64 32
SESSION_SECRET=replace-with-a-long-random-secret

# 管理者ログイン（実値はコミットしない）
ADMIN_EMAIL=admin@example.invalid
# npm run auth:hash -- 'your-password' の出力を設定
ADMIN_PASSWORD_HASH=\$2b\$12\$replace_with_a_real_bcrypt_hash

# 公開URL（末尾スラッシュなし）
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 原稿取込APIを一時的に有効化する強いランダム値。通常運用では未設定にします
MANUSCRIPT_IMPORT_TOKEN=
